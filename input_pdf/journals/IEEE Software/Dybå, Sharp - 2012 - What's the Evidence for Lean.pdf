      <rdf:Description rdf:about=""
            xmlns:ieeecs="ns:bridgeqe.adobe.com/ieeecs/1.0/">
         <ieeecs:Author1Aff>SINTEF</ieeecs:Author1Aff>
         <ieeecs:Author1SName>Dyb&amp;aring;</ieeecs:Author1SName>
         <ieeecs:Author1FName>Tore</ieeecs:Author1FName>
         <ieeecs:ArticleTitle>What&amp;rsquo;s the Evidence for Lean?</ieeecs:ArticleTitle>
         <ieeecs:Abstract>A close look at the evidence underpinning the original concept of lean production and its popular interpretation reveals the inherent challenges of measuring and interpreting evidence for performance differences.</ieeecs:Abstract>
         <ieeecs:SectionTitle>Voice of Evidence</ieeecs:SectionTitle>
         <ieeecs:PageRange>19-21</ieeecs:PageRange>
         <ieeecs:FirstPage>19</ieeecs:FirstPage>
         <ieeecs:ContentType>orig-research</ieeecs:ContentType>
         <ieeecs:Issue>5</ieeecs:Issue>
         <ieeecs:Volume>29</ieeecs:Volume>
         <ieeecs:Year>2012</ieeecs:Year>
         <ieeecs:Month>September/October</ieeecs:Month>
         <ieeecs:ISSN>0740-7459</ieeecs:ISSN>
         <ieeecs:Publisher>IEEE Computer Society</ieeecs:Publisher>
         <ieeecs:MagTitle>IEEE Software</ieeecs:MagTitle>
         <ieeecs:ArticleDisplay>True</ieeecs:ArticleDisplay>
