         <ieeecs:Author1Aff>independent researcher</ieeecs:Author1Aff>
         <ieeecs:Author1SName>Gotel</ieeecs:Author1SName>
         <ieeecs:Author1FName>Olly</ieeecs:Author1FName>
         <ieeecs:ArticleTitle>Requirements Tracery</ieeecs:ArticleTitle>
         <ieeecs:Abstract>Requirements analysts need a new toolbox with both the right tools and the instructions to use them including agile development and user-centered design for techniques such as analysis of Web analytics, wire-framing, and user stories. We can also look to the creativity literature and take techniques such as constraint removal, storytelling, and other worlds.</ieeecs:Abstract>
         <ieeecs:SectionTitle>Requirements</ieeecs:SectionTitle>
         <ieeecs:PageRange>92-94</ieeecs:PageRange>
         <ieeecs:FirstPage>92</ieeecs:FirstPage>
         <ieeecs:ContentType>orig-research</ieeecs:ContentType>
         <ieeecs:Issue>5</ieeecs:Issue>
         <ieeecs:Volume>28</ieeecs:Volume>
         <ieeecs:Year>2011</ieeecs:Year>
         <ieeecs:Month>September/October</ieeecs:Month>
         <ieeecs:ISSN>0740-7459</ieeecs:ISSN>
         <ieeecs:Publisher>IEEE Computer Society</ieeecs:Publisher>
         <ieeecs:MagTitle>IEEE Software</ieeecs:MagTitle>
         <ieeecs:ArticleDisplay>True</ieeecs:ArticleDisplay>
         <ieeecs:InDDFilename>s5req</ieeecs:InDDFilename>
         <ieeecs:BuyMe>True</ieeecs:BuyMe>
         <ieeecs:ShowHTM>False</ieeecs:ShowHTM>
         <ieeecs:ShowPDF>True</ieeecs:ShowPDF>
         <ieeecs:IssueDisplay>False</ieeecs:IssueDisplay>
         <ieeecs:Keywords>software engineering; requirements; techniques; agile; creativity; meaning carriers</ieeecs:Keywords>
         <ieeecs:Author2FName>Stephen</ieeecs:Author2FName>
         <ieeecs:Author2SName>Morris</ieeecs:Author2SName>
         <ieeecs:Author2Aff>City University London</ieeecs:Author2Aff>
